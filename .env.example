# =============================================================================
# CABRAL & SOUZA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha cada valor.
# NUNCA commite .env.local ou qualquer arquivo com secrets reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Public (expostas ao browser)
# Obter em: https://supabase.com → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# Supabase — Server only (NUNCA expor ao browser)
# Obter em: Settings → API → service_role key
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Anthropic Claude API
# Obter em: https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# OpenAI (embeddings text-embedding-3-small)
# Alternativa: VOYAGE_API_KEY se usar Voyage AI
# Obter em: https://platform.openai.com → API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# -----------------------------------------------------------------------------
# Resend (email transacional)
# Obter em: https://resend.com → API Keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=galeria@cabralesouza.com.br

# -----------------------------------------------------------------------------
# Analytics
# Obter em: Google Analytics 4 → Admin → Data Streams → Measurement ID
# Meta Pixel: https://business.facebook.com → Events Manager
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-...
NEXT_PUBLIC_META_PIXEL_ID=...

# -----------------------------------------------------------------------------
# Admin — emails autorizados (separados por vírgula, sem espaço)
# Apenas esses emails podem autenticar via magic link no admin
# -----------------------------------------------------------------------------
ADMIN_EMAILS=executor@email.com,marcelo@cabralesouza.com.br

# -----------------------------------------------------------------------------
# WhatsApp Bot (service separado — só necessário para o serviço whatsapp-bot)
# -----------------------------------------------------------------------------
WPP_SESSION_NAME=cabralesouza
WPP_WEBHOOK_URL=https://cabralesouza.com.br/api/webhooks/whatsapp
WPP_SHARED_SECRET=gere_um_secret_aleatorio_aqui

# -----------------------------------------------------------------------------
# Sentry (monitoramento de erros — opcional no início)
# Obter em: https://sentry.io → Projetos → DSN
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
