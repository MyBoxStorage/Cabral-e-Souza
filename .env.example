# =============================================================================
# CABRAL & SOUZA — Variáveis de Ambiente
# Copie este arquivo para apps/web/.env.local e preencha cada valor.
# NUNCA commite .env.local ou qualquer arquivo com secrets reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Public (expostas ao browser)
# Obter em: https://supabase.com/dashboard → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Supabase — Server only (NUNCA expor ao browser)
# Obter em: Settings → API → service_role (secret)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# PostgreSQL — migrations (server only, NUNCA expor)
# Senha: Dashboard → Project Settings → Database → Database password
# Pooler host: Dashboard → Connect → Session/Transaction pooler → copie o host
# -----------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=your-database-password-here
SUPABASE_DB_REGION=sa-east-1
SUPABASE_DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com
# DATABASE_URL é montada automaticamente pelo script pnpm db:migrate

# -----------------------------------------------------------------------------
# Site
# Desenvolvimento: http://localhost:3000
# Produção: https://cabralesouza.com.br
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Anthropic Claude API (agente de proveniência — etapa futura)
# Obter em: https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------------------------------------
# OpenAI (embeddings — etapa futura)
# Obter em: https://platform.openai.com → API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here
# VOYAGE_API_KEY=pa-your-key-here

# -----------------------------------------------------------------------------
# Resend (email transacional)
# 1. Crie conta gratuita: https://resend.com/signup
# 2. Verifique seu domínio (ou use onboarding@resend.dev só em dev)
# 3. API Keys → Create API Key → copie re_...
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=contato@cabralesouza.com.br
# Legado (opcional — FROM_EMAIL tem prioridade):
# RESEND_FROM_EMAIL=contato@cabralesouza.com.br

# -----------------------------------------------------------------------------
# Notificações ao executor (leads de sourcing e interesse em obras)
# Email que recebe alertas em tempo real (ex: executor da galeria)
# -----------------------------------------------------------------------------
EXECUTOR_NOTIFICATION_EMAIL=executor@seu-dominio.com

# -----------------------------------------------------------------------------
# Webhooks (validação HMAC dos endpoints /api/webhooks/*)
# Gere com: openssl rand -hex 32
# Configure o mesmo valor no header x-webhook-signature do Supabase Database Webhook
# -----------------------------------------------------------------------------
WEBHOOK_SHARED_SECRET=your-webhook-secret-here

# -----------------------------------------------------------------------------
# Analytics (opcional)
# GA4: https://analytics.google.com → Admin → Data Streams
# Meta: https://business.facebook.com → Events Manager
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXX

# -----------------------------------------------------------------------------
# Admin — emails autorizados (vírgula, sem espaço)
# Dashboard → Authentication → Users deve ter conta com esse email
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin1@dominio.com,admin2@dominio.com

# -----------------------------------------------------------------------------
# WhatsApp Bot (serviço separado — opcional)
# -----------------------------------------------------------------------------
WPP_SESSION_NAME=cabralesouza
WPP_WEBHOOK_URL=https://cabralesouza.com.br/api/webhooks/whatsapp
WPP_SHARED_SECRET=your-whatsapp-webhook-secret-here

# -----------------------------------------------------------------------------
# Sentry (opcional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
