# =============================================================================
# CABRAL & SOUZA — Variáveis de Ambiente
# Copie este arquivo para apps/web/.env.local e preencha cada valor.
# NUNCA commite .env.local ou qualquer arquivo com secrets reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Public (expostas ao browser)
# Obter em: https://supabase.com → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key...

# -----------------------------------------------------------------------------
# Supabase — Server only (NUNCA expor ao browser)
# Obter em: Settings → API → service_role key
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# -----------------------------------------------------------------------------
# PostgreSQL — migrations (server only, NUNCA expor)
# Obter senha em: Supabase Dashboard → Project Settings → Database → Database password
# Região do projeto cabral-souza: sa-east-1
# -----------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=sua-senha-do-banco
SUPABASE_DB_REGION=sa-east-1
# Pooler (gerado automaticamente pelo script db:migrate):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Site
# Em desenvolvimento: http://localhost:3000
# Em produção: https://cabralesouza.com.br
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cabralesouza.com.br

# -----------------------------------------------------------------------------
# Anthropic Claude API
# Obter em: https://console.anthropic.com → API Keys → Create Key
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# OpenAI (embeddings text-embedding-3-small)
# Alternativa: VOYAGE_API_KEY se usar Voyage AI
# Obter em: https://platform.openai.com → API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
# VOYAGE_API_KEY=pa-...

# -----------------------------------------------------------------------------
# Resend (email transacional)
# Obter em: https://resend.com → API Keys → Create API Key
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=galeria@cabralesouza.com.br

# -----------------------------------------------------------------------------
# Analytics
# GA4: https://analytics.google.com → Admin → Data Streams → Measurement ID
# Meta Pixel: https://business.facebook.com → Events Manager
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-...
NEXT_PUBLIC_META_PIXEL_ID=...

# -----------------------------------------------------------------------------
# Admin — emails autorizados (separados por vírgula, sem espaço)
# Apenas esses emails podem autenticar no admin (camada extra além do Supabase Auth)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=email1@dominio.com,email2@dominio.com

# -----------------------------------------------------------------------------
# WhatsApp Bot (service separado — só necessário para o serviço whatsapp-bot)
# WPP_SHARED_SECRET: gere com: openssl rand -hex 32
# -----------------------------------------------------------------------------
WPP_SESSION_NAME=cabralesouza
WPP_WEBHOOK_URL=https://cabralesouza.com.br/api/webhooks/whatsapp
WPP_SHARED_SECRET=gere_um_secret_aleatorio_aqui

# -----------------------------------------------------------------------------
# Sentry (monitoramento de erros — opcional no início)
# Obter em: https://sentry.io → seu projeto → Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
